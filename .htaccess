# ============================================================
#  Apache configuration
# ============================================================

DirectoryIndex index.php

Options -Indexes +FollowSymLinks
RewriteEngine On

# Clean homepage address: anyone who opens ".../index.php" is sent to ".../"
# (THE_REQUEST = what the browser actually asked for, so Apache's own
#  internal DirectoryIndex lookup of index.php is not redirected in a loop.)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.php[\s?] [NC]
RewriteRule ^(?:.*/)?index\.php$ /%1 [R=301,L]

# Security: block access to sensitive files
<FilesMatch "\.(sql|log|env|toml|md|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Security headers: no framing by other sites (clickjacking), no MIME sniffing,
# and don't leak full URLs (with patient IDs) to other sites.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# PHP settings
php_flag display_errors off
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 60
