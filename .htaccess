# ============================================================
#  Apache configuration
# ============================================================

DirectoryIndex index.php

Options -Indexes +FollowSymLinks
RewriteEngine On

# Clean addresses without ".php": /login is served by login.php.
# (An internal rewrite, so the address bar keeps showing /login.)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9_-]+)$ $1.php [L]

# Any other address that isn't a real file or folder (e.g. /admin/dashboard,
# /any-route) goes to the route guard: signed-in users to their own home
# page, guests to /login. Only page-like addresses (no file extension, or
# .php), so a missing image or script still gets a plain 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?:[^.]*|.*\.php)$ not_found.php [L]

# Security: block access to sensitive files
<FilesMatch "\.(sql|log|env|toml|md|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Security headers: no framing by other sites (clickjacking), no MIME sniffing,
# and don't leak full URLs (with patient IDs) to other sites.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# PHP settings
php_flag display_errors off
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 60
